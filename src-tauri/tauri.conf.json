{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeeCode",
  "mainBinaryName": "codeg",
  "version": "0.41.3",
  "identifier": "app.codeg",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": [
      "binaries/codeg-mcp",
      "binaries/codeg-computer-helper",
      "binaries/codeg-cli"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop",
        "conflicts": ["codeg"],
        "replaces": ["codeg"]
      },
      "rpm": {
        "desktopTemplate": "./linux/main.desktop",
        "obsoletes": ["codeg"],
        "provides": ["codeg"]
      }
    },
    "macOS": {
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codeg"]
      }
    },
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMTU2NURGMDgzRjVFOUEKUldTYVhqOEkzMlVWckJpRDFkRXBNZjdTc2lYMlZwcnpOcURKUjhBZkZsa0JXN3FsZHdXQzlFSisK",
      "endpoints": [
        "https://github.com/EvanZheng11/beecode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
